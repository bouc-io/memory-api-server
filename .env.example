DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3000
CORS_ORIGIN="*"

# Logging level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Embedding Configuration (via Ollama)
# The embedding model must be pulled in Ollama before use (e.g. ollama pull nomic-embed-text)
# Current standard: nomic-embed-text (768 dimensions). Changing models requires re-embedding
# (npm run migrate:re-embed).
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
ALLOW_SELF_SIGNED_CERTS=false

# Summarization model used for memory compression (POST /v1/memories/compress)
# Must be a chat model available in Ollama (e.g. ollama pull qwen3.5:2b)
SUMMARIZATION_MODEL=qwen3.5:2b

# LLM Assignment — embedding provider from admin-api-server
# When set, memory-api-server resolves the embedding model dynamically via
# GET /v1/config/llm-assignment/memory_embedding using the request's Bearer token.
# Falls back to OLLAMA_URL + EMBEDDING_MODEL if unset or if no assignment is configured.
ADMIN_API_URL=http://admin-api-chart.default.svc.cluster.local:80

# Memory ranking & lifecycle (Phase 6b)
MEMORY_DEDUP_THRESHOLD="0.92"          # cosine >= this on create => treat as duplicate
MEMORY_RECENCY_HALFLIFE_DAYS="30"      # composite-ranking recency half-life
MEMORY_TTL_LOW_DAYS="90"               # prune:memories — low-importance inactivity window
MEMORY_TTL_MEDIUM_DAYS="180"           # prune:memories — medium-importance inactivity window
MEMORY_PRUNE_DRY_RUN="false"           # "true" = report counts without deactivating
