{
  "name": "memory-api-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run prompts:build && prisma generate && tsc",
    "prompts:build": "ts-node scripts/buildPrompts.ts",
    "prompts:check": "ts-node scripts/buildPrompts.ts --check",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "migrate:re-embed": "node -r ts-node/register scripts/re-embed-all.ts",
    "test:watch": "vitest",
    "prune:memories": "node dist/scripts/pruneMemories.js",
    "prune:memories:dev": "ts-node src/scripts/pruneMemories.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "test:ci": "vitest run --coverage"
  },
  "keywords": [
    "llm",
    "memory",
    "rag",
    "pgvector",
    "embeddings",
    "kubernetes"
  ],
  "author": "",
  "license": "Elastic-2.0",
  "description": "pgvector-backed memory retrieval service for the bouc.io AI assistant platform.",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.6"
  },
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.14",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.7",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
